<Window
    x:Class="Stawn.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Stawn.Views">
    <!-- Part window laid out the way feature-based CAD users expect: menus and quick-access
         buttons, the CommandManager, the FeatureManager / PropertyManager pane on the left, the
         graphics area, the task pane on the right and the status bar. -->
    <Grid x:Name="Root" Background="#F3F4F6" RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- title bar -->
            <RowDefinition Height="Auto" />  <!-- menus and quick-access buttons -->
            <RowDefinition Height="Auto" />  <!-- CommandManager -->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />  <!-- status bar -->
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Height="32" Padding="10,0,140,0" Background="#E4E7EB">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Source="Assets/StawnCADPro.png" Width="18" Height="18" />
                <TextBlock Text="STAWN CAD Pro" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="TitleText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
        </Grid>

        <Grid Grid.Row="1" Background="#F3F4F6" BorderBrush="#D5D9DE" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <MenuBar Padding="0">
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Text="New Part" Click="OnNew">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="N" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Open…" Click="OnOpen">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="O" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Open Sample Shaft" Click="OnSample" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="SaveItem" Text="Save" Click="OnSave">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="S" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="SaveAsItem" Text="Save As…" Click="OnSaveAs" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="ImportItem" Text="Import STEP…" Click="OnImportStep" />
                    <MenuFlyoutSubItem x:Name="ExportItem" Text="Export">
                        <MenuFlyoutItem Text="STEP (*.step)…" Click="OnExportStep" />
                        <MenuFlyoutItem Text="STL (*.stl)…" Click="OnExportStl" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Click="OnExit" />
                </MenuBarItem>
                <MenuBarItem Title="View">
                    <!-- F and Ctrl+8 are handled by the graphics area so they never fire while typing in a field -->
                    <MenuFlyoutItem Text="Zoom to Fit" Click="OnZoomToFit" KeyboardAcceleratorTextOverride="F" />
                    <MenuFlyoutItem Text="Normal To" Click="OnNormalTo" KeyboardAcceleratorTextOverride="Ctrl+8" />
                    <MenuFlyoutSubItem x:Name="OrientationMenu" Text="Orientation" />
                    <MenuFlyoutSubItem x:Name="DisplayStyleMenu" Text="Display Style" />
                </MenuBarItem>
                <MenuBarItem Title="Insert">
                    <MenuFlyoutItem Text="Sketch on Front Plane" Click="OnSketchFront" />
                    <MenuFlyoutItem Text="Sketch on Top Plane" Click="OnSketchTop" />
                    <MenuFlyoutItem Text="Sketch on Right Plane" Click="OnSketchRight" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Boss/Base Extrude…" Click="OnInsertExtrude" />
                    <MenuFlyoutItem Text="Boss/Base Revolve…" Click="OnInsertRevolve" />
                    <MenuFlyoutItem Text="Cut Extrude…" Click="OnInsertCutExtrude" />
                    <MenuFlyoutItem Text="Cut Revolve…" Click="OnInsertCutRevolve" />
                    <MenuFlyoutItem Text="Fillet…" Click="OnInsertFillet" />
                    <MenuFlyoutItem Text="Chamfer…" Click="OnInsertChamfer" />
                </MenuBarItem>
                <MenuBarItem Title="Tools">
                    <MenuFlyoutItem Text="Mass Properties" Click="OnMassProperties" />
                    <MenuFlyoutItem Text="Material…" Click="OnEditMaterial" />
                    <MenuFlyoutItem Text="Run Commands…" Click="OnRunCommands" />
                </MenuBarItem>
                <MenuBarItem Title="Help">
                    <MenuFlyoutItem Text="About STAWN CAD Pro" Click="OnAbout" />
                </MenuBarItem>
            </MenuBar>
            <Border Grid.Column="1" Width="1" Margin="6,6" Background="#D5D9DE" />
            <!-- Quick-access buttons -->
            <StackPanel x:Name="QuickAccess" Grid.Column="2" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center" />
        </Grid>

        <views:Ribbon x:Name="CommandManager" Grid.Row="2" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TaskPaneColumn" Width="300" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left pane: FeatureManager tree, PropertyManager, ConfigurationManager, and the
                 PropertyManager pages of the command in progress -->
            <Grid Background="White" BorderBrush="#C9CED6" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="ManagerTabs" Orientation="Horizontal" Spacing="2" Padding="4,4,4,2" Background="#EEF0F3"
                            BorderBrush="#D5D9DE" BorderThickness="0,0,0,1" />
                <views:FeatureTree x:Name="FeatureTreePanel" Grid.Row="1" />
                <views:PropertyManagerPanel x:Name="PropertyPanel" Grid.Row="1" Visibility="Collapsed" Background="White" />
                <views:ConfigurationManagerPanel x:Name="ConfigurationPanel" Grid.Row="1" Visibility="Collapsed" Background="White" />
                <ContentControl x:Name="PageHost" Grid.Row="1" Visibility="Collapsed" Background="#F7F8FA"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>

            <!-- Graphics area -->
            <Grid Grid.Column="1">
                <views:Viewport x:Name="View3D" />
                <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" Padding="6,2"
                        CornerRadius="4" Background="#E6FFFFFF" BorderBrush="#C9CED6" BorderThickness="1">
                    <StackPanel x:Name="HeadsUp" Orientation="Horizontal" Spacing="1" />
                </Border>
                <TextBlock x:Name="ViewNameText" Text="*Isometric" Margin="96,0,0,14" FontSize="12" Foreground="#30343A"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                <!-- Confirmation corner: finish or cancel the sketch or command in progress -->
                <StackPanel x:Name="ConfirmationCorner" Orientation="Horizontal" Spacing="4" Margin="0,8,10,0" Visibility="Collapsed"
                            HorizontalAlignment="Right" VerticalAlignment="Top" />
                <!-- Smart Dimension's Modify box, placed at the cursor -->
                <Canvas x:Name="ModifyLayer">
                    <Border x:Name="ModifyBox" Visibility="Collapsed" Padding="8" CornerRadius="4" Background="White"
                            BorderBrush="#8A97A8" BorderThickness="1">
                        <StackPanel Spacing="6" Width="190">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Modify" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="ModifyName" Foreground="#5A6270" VerticalAlignment="Center" />
                            </StackPanel>
                            <RadioButtons x:Name="ModifyOptions" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button x:Name="ModifyOk" Padding="4,2" ToolTipService.ToolTip="Save the value (Enter)" />
                                <Button x:Name="ModifyCancel" Padding="4,2" ToolTipService.ToolTip="Cancel (Esc)" />
                                <NumberBox x:Name="ModifyValue" Width="110" AcceptsExpression="True" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Canvas>
                <views:WelcomePanel x:Name="Welcome" Visibility="Collapsed" />
            </Grid>

            <!-- Task pane and its tab strip -->
            <views:CustomPropertiesPane x:Name="PropertiesPane" Grid.Column="2" Background="White"
                BorderBrush="#C9CED6" BorderThickness="1,0,0,0" />
            <StackPanel x:Name="TaskTabs" Grid.Column="3" Width="34" Spacing="2" Padding="2,6" Background="#E8EAED"
                        BorderBrush="#C9CED6" BorderThickness="1,0,0,0" />
        </Grid>

        <Grid Grid.Row="4" Padding="10,3" Background="#E4E7EB" BorderBrush="#C9CED6" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusLeft" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusCoordinates" FontSize="12" />
                <TextBlock x:Name="StatusDefinition" FontSize="12" />
                <TextBlock x:Name="StatusEditing" FontSize="12" />
                <TextBlock x:Name="StatusMass" FontSize="12" />
                <TextBlock Text="MMGS" FontSize="12" ToolTipService.ToolTip="Millimetre, gram, second" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
